rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All data ligger under g/<gruppkod>/. Koden står bara i inbjudningslänken,
    // och g/ går inte att lista, så utan koden kommer man inte åt något.
    match /g/{code}/{coll}/{id} {
      allow read: if code.size() >= 20 && coll.matches('[a-z]{2,20}');
      allow write: if code.size() >= 20 && coll.matches('[a-z]{2,20}')
        && (request.resource == null || request.resource.data.size() <= 30);
    }
  }
}
