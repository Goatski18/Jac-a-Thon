rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deltagardelen: g/<gruppkod>/... Koden står bara i inbjudningslänken.
    match /g/{code}/{coll}/{id} {
      allow read: if code.size() >= 20 && coll.matches('[a-z]{2,20}');
      allow write: if code.size() >= 20 && coll.matches('[a-z]{2,20}')
        && (request.resource == null || request.resource.data.size() <= 30);
    }
    // Arrangörsdelen: o/<SHA-256 av gruppkod + PIN>/... Utan PIN går sökvägen inte att räkna fram.
    match /o/{key}/{coll}/{id} {
      allow read: if key.size() == 64 && coll.matches('[a-z]{2,20}');
      allow write: if key.size() == 64 && coll.matches('[a-z]{2,20}')
        && (request.resource == null || request.resource.data.size() <= 30);
    }
  }
}
